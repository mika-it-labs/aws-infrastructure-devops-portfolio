{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunOnlyDay4Batch",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:ap-northeast-1:ACCOUNT_ID:task-definition/portfolio-day4-batch:1",
      "Condition": {
        "ArnEquals": {
          "ecs:cluster": "arn:aws:ecs:ap-northeast-1:ACCOUNT_ID:cluster/portfolio-day4-cluster"
        }
      }
    },
    {
      "Sid": "ObserveAndStopDay4Tasks",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTasks",
        "ecs:StopTask"
      ],
      "Resource": "arn:aws:ecs:ap-northeast-1:ACCOUNT_ID:task/portfolio-day4-cluster/*"
    },
    {
      "Sid": "SyncCompletionRule",
      "Effect": "Allow",
      "Action": [
        "events:PutTargets",
        "events:PutRule",
        "events:DescribeRule"
      ],
      "Resource": "arn:aws:events:ap-northeast-1:ACCOUNT_ID:rule/StepFunctionsGetEventsForECSTaskRule"
    },
    {
      "Sid": "PublishOnlyDay4Topic",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-northeast-1:ACCOUNT_ID:portfolio-day4-alerts"
    },
    {
      "Sid": "PassOnlyExistingExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
